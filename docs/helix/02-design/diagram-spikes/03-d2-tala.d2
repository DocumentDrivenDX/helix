vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    pad: 64
  }
}
label: HELIX solution architecture
style: {
  fill: "#F8FAFC"
  font-size: 36
  font-color: "#18324D"
}
direction: right
classes: {
  entity: {
    style: {
      fill: "#FFFFFF"
      stroke: "#7891AB"
      stroke-width: 2
      font-size: 24
      font-color: "#18324D"
      border-radius: 10
    }
  }
  constraint: {style: {stroke-dash: 5; stroke: "#58739D"; font-size: 20}}
  action: {style: {stroke: "#234C87"; stroke-width: 2; font-size: 20}}
}
team: Software team {class: entity; shape: person}
runtime: Agent runtime\nModel, tools, execution {class: entity}
helix: HELIX · portable content {
  style: {fill: "#E7EFFB"; stroke: "#7698C4"; stroke-dash: 5; font-size: 24}
  catalog: Artifact catalog\nTemplates, prompts, rules {class: entity}
  skill: Routing skill\nScope and mode {class: entity; style: {fill: "#234C87"; stroke: "#234C87"; font-color: "#FFFFFF"}}
  catalog -> skill: guides {class: constraint}
}
scope: .helix.yml\nProject scope {class: entity; shape: document}
docs: Project documents\nIntent, design, tests {class: entity; shape: document; style: {fill: "#DFF1EA"; stroke: "#28765F"}}
team -> runtime: asks {class: action}
runtime -> helix.skill: loads {class: action}
scope -> helix.skill: bounds {class: constraint}
helix.skill -> docs: authors &\nreconciles {class: action}
docs -> runtime: governs authorized execution {class: action; style.stroke: "#28765F"}

# Conference composition: pin entities; TALA sizes containers and routes edges.
headline: HELIX solution architecture {shape: text; left: 0; top: 0; width: 1740; height: 70; style: {font-size: 46; bold: true}}
subtitle: Portable document discipline, operated by your agent runtime {shape: text; left: 0; top: 90; width: 1740; height: 40; style.font-size: 24}
team: {left: 0; top: 470; width: 170; height: 150}
runtime: {left: 300; top: 480; width: 330; height: 130}
helix: {left: 740; top: 200; width: 470; height: 470}
helix.catalog: {left: 40; top: 80; width: 390; height: 110}
helix.skill: {left: 40; top: 280; width: 390; height: 130}
scope: {left: 830; top: 790; width: 300; height: 110}
docs: {left: 1400; top: 480; width: 330; height: 130}
